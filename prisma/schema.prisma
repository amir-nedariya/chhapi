generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGO_URI")
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String?
  mobile       String   @unique
  password     String
  role         Role     @default(USER)
  profilePhoto String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
