generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

model User {
  id             String    @id @default(uuid())
  name           String?
  mobile         String    @unique
  email          String?   @unique
  password       String
  role           Role      @default(USER)
  profilePhoto   String?
  isActive       Boolean   @default(true)
  resetOtp       String?
  resetOtpExpiry DateTime?
  monthlyStats   Json?
  yearlyStats    Json?
  totalDonations Int?      @default(0)
  donationCount  Int?      @default(0)
  avgDonation    Float?    @default(0)
  isDeleted      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  createdBy      String?   @default("System")
  updatedAt      DateTime  @updatedAt
  updatedBy      String?
  deletedAt      DateTime?
  deletedBy      String?
}

model Donation {
  id              String   @id @default(uuid())
  donorId         String
  donorName       String?
  amount          Float
  month           Int
  year            Int
  status          String   @default("Pending")
  paymentMethod   String?
  remarks         String?
  collectedById   String?
  collectedByName String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Fund {
  id              String      @id @default(uuid())
  title           String
  year            Int
  month           Int
  totalAmount     Float
  usedAmount      Float       @default(0)
  remainingAmount Float
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  usages          FundUsage[]
}

model FundUsage {
  id          String   @id @default(uuid())
  fundId      String
  fund        Fund     @relation(fields: [fundId], references: [id], onDelete: Cascade)
  amount      Float
  note        String
  usedById    String?
  usedByName  String?
  usedByRole  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FundRequest {
  id             String   @id @default(uuid())
  name           String
  mobile         String
  role           String   @default("USER")
  userId         String?
  amount         Float
  reason         String
  photo          String?
  status         String   @default("Pending") // "Pending", "Approved", "Rejected"
  reviewedById   String?
  reviewedByName String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
