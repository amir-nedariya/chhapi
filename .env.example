# MongoDB Connection URI (Note: Prisma requires MongoDB to run as a replica set)
MONGO_URI="mongodb://127.0.0.1:27017/chhapi_donation?replicaSet=rs0"

# JWT secret for authentication
JWT_SECRET="your_jwt_secret_here"

# Cloudinary configuration
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# SMTP Email Configuration (for Forgot Password OTP emails)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_password"
SMTP_FROM='"Chhapi Support" <your_email@gmail.com>'
